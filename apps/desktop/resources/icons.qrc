<!-- Sidebar navigation icons - see Media/icons/README.md for the icon-to-
     module mapping and Media/icons' own files for source attribution
     (THIRD_PARTY_NOTICES.md). Referenced from their canonical location
     (Media/icons/, repo root) rather than duplicated under resources/, so
     there's exactly one copy of each SVG to keep in sync. -->
<RCC>
    <qresource prefix="/nexuspc/icons">
        <file alias="home.svg">../../../Media/icons/home.svg</file>
        <file alias="alert.svg">../../../Media/icons/alert.svg</file>
        <file alias="storage.svg">../../../Media/icons/storage.svg</file>
        <file alias="vault.svg">../../../Media/icons/vault.svg</file>
        <file alias="network.svg">../../../Media/icons/network.svg</file>
        <file alias="internet.svg">../../../Media/icons/internet.svg</file>
        <file alias="performance.svg">../../../Media/icons/performance.svg</file>
        <file alias="backup.svg">../../../Media/icons/backup.svg</file>
        <file alias="search.svg">../../../Media/icons/search.svg</file>
        <file alias="reports.svg">../../../Media/icons/reports.svg</file>
        <file alias="settings.svg">../../../Media/icons/settings.svg</file>
        <file alias="continuity.svg">../../../Media/icons/continuity.svg</file>
    </qresource>
</RCC>
